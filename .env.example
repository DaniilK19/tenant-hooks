# Fake local-development values. `docker compose up` works without a .env file;
# copy this to .env only if you want to override them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-superuser
POSTGRES_DB=tenant_hooks

# Owner: runs migrations. Subject to FORCE ROW LEVEL SECURITY.
HOOKS_OWNER_PASSWORD=local-dev-only-owner
# API: restricted role used by the HTTP service.
HOOKS_API_PASSWORD=local-dev-only-api
# Worker: restricted role used by the background worker.
HOOKS_WORKER_PASSWORD=local-dev-only-worker
